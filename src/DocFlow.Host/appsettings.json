{
  "ConnectionStrings": {
    "DocFlow": "Host=localhost;Port=5432;Database=docflow;Username=docflow;Password=docflow"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "Engine": {
    "PollIntervalSeconds": 15,
    "SignalScanIntervalSeconds": 15,
    "RunnerIntervalSeconds": 3,
    "MaxAttempts": 3,
    "RetryBaseDelaySeconds": 30,
    "MaxParallelProcesses": 4
  },
  "Storage": {
    "WorkingDir": "./data/work",
    "SignatureDir": "./data/signature",
    "ResultDir": "./data/result"
  },
  "Intake": {
    "Directories": [
      { "Path": "./data/in/report", "DocumentType": "report" }
    ]
  }
}
